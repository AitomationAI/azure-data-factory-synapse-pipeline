{
    "name": "pl_ingest_partner_files",
    "properties": {
        "description": "Moves partner policyholder CSV drops from inbound/ to bronze/. Malformed rows are skipped and logged to quarantine/ instead of failing the run.",
        "parameters": {
            "loadDate": {
                "type": "string"
            }
        },
        "folder": {
            "name": "ingest"
        },
        "activities": [
            {
                "name": "list_inbound_files",
                "type": "GetMetadata",
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 60,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "dataset": {
                        "referenceName": "ds_lake_csv",
                        "type": "DatasetReference",
                        "parameters": {
                            "container": "inbound",
                            "folderPath": "partner",
                            "fileName": ""
                        }
                    },
                    "fieldList": [
                        "childItems"
                    ]
                }
            },
            {
                "name": "only_csv_files",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "list_inbound_files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@activity('list_inbound_files').output.childItems",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@and(equals(item().type, 'File'), endswith(toLower(item().name), '.csv'))",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "foreach_file",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "only_csv_files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@activity('only_csv_files').output.value",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 8,
                    "activities": [
                        {
                            "name": "copy_file_to_bronze",
                            "type": "Copy",
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "source": {
                                    "type": "DelimitedTextSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings"
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    }
                                },
                                "enableSkipIncompatibleRow": true,
                                "logSettings": {
                                    "enableCopyActivityLog": true,
                                    "copyActivityLogSettings": {
                                        "logLevel": "Warning",
                                        "enableReliableLogging": true
                                    },
                                    "logLocationSettings": {
                                        "linkedServiceName": {
                                            "referenceName": "ls_adls",
                                            "type": "LinkedServiceReference"
                                        },
                                        "path": {
                                            "value": "quarantine/partner_files/load_date=@{pipeline().parameters.loadDate}",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_lake_csv",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "inbound",
                                        "folderPath": "partner",
                                        "fileName": {
                                            "value": "@item().name",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_lake_parquet",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "bronze",
                                        "folderPath": {
                                            "value": "policyholders/load_date=@{pipeline().parameters.loadDate}",
                                            "type": "Expression"
                                        },
                                        "fileName": {
                                            "value": "@{replace(item().name, '.csv', '')}.parquet",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "delete_processed_file",
                            "type": "Delete",
                            "policy": {
                                "timeout": "0.02:00:00",
                                "retry": 2,
                                "retryIntervalInSeconds": 60,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "dependsOn": [
                                {
                                    "activity": "copy_file_to_bronze",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "typeProperties": {
                                "dataset": {
                                    "referenceName": "ds_lake_csv",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "container": "inbound",
                                        "folderPath": "partner",
                                        "fileName": {
                                            "value": "@item().name",
                                            "type": "Expression"
                                        }
                                    }
                                },
                                "enableLogging": false,
                                "storeSettings": {
                                    "type": "AzureBlobFSReadSettings",
                                    "recursive": false
                                }
                            }
                        }
                    ]
                }
            }
        ]
    }
}
